<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_bg"
    android:padding="8dp">

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/tvStatus" android:text="Tap the mic and speak" android:textColor="@color/keyboard_text" android:textSize="12sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"/>
        <TextView android:id="@+id/tvEngine" android:text="WHISPER | small" android:textColor="@color/keyboard_bg" android:background="@color/badge_yellow" android:textSize="9sp" android:textStyle="bold" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginEnd="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKeyboardGear" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:minHeight="48dp" app:icon="@android:drawable/ic_menu_preferences" app:iconTint="@color/white" android:contentDescription="Open app settings"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseKeyboard" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="48dp" android:minHeight="48dp" app:icon="@android:drawable/ic_menu_close_clear_cancel" app:iconTint="@color/white" android:contentDescription="@string/switch_previous_keyboard"/>
    </LinearLayout>

    <!-- Selected options as read-only labels -->
    <TextView android:id="@+id/tvLabels" android:text="" android:textColor="@color/label_blue" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:paddingTop="2dp"/>

    <!-- Outstanding transcripts held for later - one tap inserts oldest -->
    <LinearLayout android:id="@+id/rowOutstanding" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="4dp" android:visibility="gone">
        <Button android:id="@+id/btnTypeOutstanding" android:text="@string/type_pending_transcript" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:minHeight="48dp" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" android:backgroundTint="@color/key_blue"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDiscardOutstanding" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="48dp" android:minHeight="48dp" app:icon="@android:drawable/ic_menu_delete" app:iconTint="@color/white" android:contentDescription="@string/discard_pending_transcript"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">

        <!-- Big circular record button (real mic / stop icons) -->
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnMicCircle"
                android:layout_width="72dp" android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#00B894"
                android:src="@drawable/ic_mic"
                android:contentDescription="Record"/>
        </FrameLayout>

        <!-- Backspace + Enter (tap = single-char/line, hold = repeat) -->
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBackspace" style="@style/Widget.Material3.Button.IconButton" android:layout_width="62dp" android:layout_height="52dp" android:minWidth="48dp" android:minHeight="48dp" app:icon="@drawable/ic_backspace" app:iconTint="@color/white" app:iconSize="28dp" android:contentDescription="@string/backspace"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEnter" style="@style/Widget.Material3.Button.IconButton" android:layout_width="62dp" android:layout_height="48dp" android:layout_marginTop="4dp" android:minWidth="48dp" android:minHeight="48dp" app:icon="@drawable/ic_enter" app:iconTint="@color/white" app:iconSize="26dp" android:contentDescription="Enter: new line"/>
        </LinearLayout>
    </LinearLayout>

    <!-- SPACE row: wide space key -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <Button android:id="@+id/btnSpace" android:text="@string/space" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:minHeight="48dp" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/white" android:background="@drawable/bg_keyboard_key" android:contentDescription="@string/space"/>
    </LinearLayout>

    <!-- Always visible: progress + processing controls + badge -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ProgressBar android:id="@+id/progressTranscribe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="100" android:progress="0" android:progressTint="@color/accent_green"/>
        <TextView android:id="@+id/tvProgressPct" android:text="0%" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/badge_yellow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:paddingStart="6dp" android:minWidth="64dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/rowProcessing" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:visibility="gone">
        <Button android:id="@+id/btnSkipOne" android:text="@string/skip_one" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#E17055"/>
        <Button android:id="@+id/btnStopAll" android:text="@string/stop_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:layout_marginStart="6dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#D63031"/>
    </LinearLayout>

    <TextView android:id="@+id/tvQueueBadge" android:text="" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/badge_yellow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp"/>

</LinearLayout>


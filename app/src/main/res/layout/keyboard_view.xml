<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E2E"
    android:padding="8dp">

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/tvStatus" android:text="Tap the mic and speak" android:textColor="#EAEAF2" android:textSize="12sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"/>
        <Button android:id="@+id/btnKeyboardGear" android:text="⚙" android:layout_width="38dp" android:layout_height="34dp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#3A3A5C" android:contentDescription="Open app settings"/>
        <Button android:id="@+id/btnCloseKeyboard" android:text="X" android:layout_width="38dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#3A3A5C" android:contentDescription="Close keyboard (return to default keyboard)"/>
    </LinearLayout>

    <!-- Selected options as read-only labels -->
    <TextView android:id="@+id/tvLabels" android:text="" android:textColor="#9FB8FF" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:paddingTop="2dp"/>

    <!-- Outstanding transcripts held for later - one tap inserts oldest -->
    <LinearLayout android:id="@+id/rowOutstanding" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="4dp" android:visibility="gone">
        <Button android:id="@+id/btnTypeOutstanding" android:text="📥 Type pending transcript" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#212121" android:backgroundTint="#74B9FF"/>
        <Button android:id="@+id/btnDiscardOutstanding" android:text="🗑" android:layout_width="42dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:textSize="14sp" android:textColor="#FFFFFF" android:backgroundTint="#636E72" android:contentDescription="Discard oldest pending transcript"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">

        <!-- Big circular record button (real mic / stop icons) -->
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnMicCircle"
                android:layout_width="84dp" android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#00B894"
                android:src="@drawable/ic_mic"
                android:contentDescription="Record"/>
        </FrameLayout>

        <!-- Backspace only (tap = char, hold = words accelerating) -->
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <Button android:id="@+id/btnBackspace" android:text="⌫" android:layout_width="62dp" android:layout_height="52dp" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#3A3A5C" android:contentDescription="Backspace: tap deletes a character, hold deletes words faster and faster"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Always visible: progress + processing controls + badge -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ProgressBar android:id="@+id/progressTranscribe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="100" android:progress="0" android:progressTint="#00B894"/>
        <TextView android:id="@+id/tvProgressPct" android:text="0%" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFD54F" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:paddingStart="6dp" android:minWidth="64dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/rowProcessing" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:visibility="gone">
        <Button android:id="@+id/btnSkipOne" android:text="Skip 1 ▸" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#E17055"/>
        <Button android:id="@+id/btnStopAll" android:text="■ Stop All" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:layout_marginStart="6dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#D63031"/>
    </LinearLayout>

    <TextView android:id="@+id/tvQueueBadge" android:text="" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFD54F" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp"/>

</LinearLayout>

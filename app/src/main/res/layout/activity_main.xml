<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFAFA" android:padding="12dp">

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

        <!-- Header -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:cardBackgroundColor="#4527A0">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp">
                <TextView android:text="Whisper Speech to Text" android:textSize="23sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Offline • Private • On-device Whisper  •  S23 FE optimized" android:textSize="13sp" android:textColor="#FFFFFF" android:alpha="0.95" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Tip: choose model &amp; output on the keyboard itself, or here." android:textSize="12sp" android:textColor="#FFFFFF" android:alpha="0.9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Setup steps -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Setup (one-time)" android:textStyle="bold" android:textSize="15sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEnableIME" android:text="1. Enable Keyboard" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPickIME" android:text="2. Switch to Whisper Speech to Text" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Model -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Model  •  also on keyboard (tiny/base/small/medium)" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerModel" android:layout_width="match_parent" android:layout_height="48dp" android:background="#FFFFFF" android:popupBackground="#FFFFFF" android:layout_marginTop="8dp" android:padding="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDownloadModel" android:text="Download Model" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestModel" android:text="Load Model Test" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <ProgressBar android:id="@+id/progressModel" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:visibility="gone" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tvDownloadStatus" android:text="Select model and download" android:textSize="13sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                <TextView android:text="Downloaded models:" android:textStyle="bold" android:textSize="13sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/tvModelInfo" android:text="" android:fontFamily="monospace" android:textSize="13sp" android:textColor="#212121" android:background="#F5F5F5" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClearModels" android:text="Clear All Models" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Voice Typing Output + Accuracy -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Voice Typing Output" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Also on keyboard: Type / Save TXT / Both  •  LIVE preview  •  VAD auto-stop  •  BT mic" android:textSize="12sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <RadioGroup android:id="@+id/radioEntryMode" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <RadioButton android:id="@+id/radioEntryType" android:text="Type into focus area (keyboard)" android:textSize="13sp" android:textColor="#212121" android:checked="true"/>
                    <RadioButton android:id="@+id/radioEntryTxt" android:text="Save to TXT — Documents/WhisperNotes/whisper_YYYY-MM-DD.txt" android:textSize="13sp" android:textColor="#212121"/>
                    <RadioButton android:id="@+id/radioEntryBoth" android:text="Both — type + save TXT" android:textSize="13sp" android:textColor="#212121"/>
                </RadioGroup>

                <TextView android:text="Accuracy" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchVad" android:text="VAD auto-stop" android:textSize="13sp" android:textColor="#212121" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:checked="true"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchLive" android:text="LIVE typing" android:textSize="13sp" android:textColor="#212121" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:checked="true"/>
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchBt" android:text="Bluetooth mic" android:textSize="13sp" android:textColor="#212121" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchCaps" android:text="Auto caps" android:textSize="13sp" android:textColor="#212121" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:checked="true"/>
                </LinearLayout>
                <TextView android:text="VAD: silence 1.3s → auto Stop. LIVE: composing preview while speaking. BT: VOICE_COMMUNICATION." android:textSize="12sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Language -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Language" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerLang" android:layout_width="match_parent" android:layout_height="48dp" android:background="#FFFFFF" android:popupBackground="#FFFFFF" android:layout_marginTop="6dp" android:padding="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Meeting -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Meeting Recording (survives lock screen)" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <RadioGroup android:id="@+id/radioMode" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <RadioButton android:id="@+id/radioTxt" android:text="Save as TXT" android:textSize="13sp" android:textColor="#212121" android:layout_width="0dp" android:layout_weight="1" android:checked="true"/>
                    <RadioButton android:id="@+id/radioType" android:text="Type into focus" android:textSize="13sp" android:textColor="#212121" android:layout_width="0dp" android:layout_weight="1"/>
                </RadioGroup>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnStartMeeting" android:text="Start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnStopMeeting" android:text="Stop &amp; Save" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvMeetingStatus" android:text="Idle" android:textSize="13sp" android:textColor="#212121" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                <TextView android:id="@+id/tvMeetingPath" android:textSize="12sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress + Queue -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Transcription Queue" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <ProgressBar android:id="@+id/progressTranscribe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="100" android:progress="0" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tvProgressPct" android:text="0% - idle" android:textSize="13sp" android:textStyle="bold" android:textColor="#4527A0" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvQueue" android:text="Queue: 0 pending | Idle" android:textSize="13sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPauseQueue" android:text="Pause" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnClearQueue" android:text="Clear" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRetryQueue" android:text="Retry Failed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Settings -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveSettings" android:text="Save Settings (updates keyboard instantly)" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>

        <!-- Donate -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF8E1" android:layout_marginTop="12dp" app:strokeColor="#FFD54F" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Support development  ♥" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="PayPal: jackfood2004@gmail.com  •  GitHub Sponsors" android:textSize="12sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDonate" android:text="Donate via PayPal" android:icon="@android:drawable/ic_menu_send" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:iconGravity="textStart"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacy -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="Privacy &amp; Logs" android:textStyle="bold" android:textSize="14sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="On-device only. Adaptive progress stats + transcript preview." android:textSize="12sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPrivacy" android:text="Open Privacy Dashboard &amp; Logs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:text="Tip: In any app, select Whisper Speech to Text, tap Speak, talk, tap Stop. LIVE shows preview via composing text. VAD auto-stops on silence." android:textSize="12sp" android:textColor="#212121" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingBottom="12dp"/>
    </LinearLayout>
</ScrollView>

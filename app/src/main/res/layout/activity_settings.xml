<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/app_background" android:padding="12dp">

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:text="@string/settings_2" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSettingsDone" android:text="@string/done" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Model -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="@string/model_engine_size_picked_here_keyboard_i" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/engine" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <Spinner android:id="@+id/spinnerEngine" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@color/surface" android:popupBackground="@color/popup" android:layout_marginTop="4dp" android:padding="8dp"/>
                <TextView android:text="@string/moonshine_v2_english_only_much_faster_wh" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@color/surface" android:popupBackground="@color/popup" android:layout_marginTop="8dp" android:padding="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDownloadModel" android:text="@string/download_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTestModel" android:text="@string/load_model_test" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <ProgressBar android:id="@+id/progressModel" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:visibility="gone" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tvDownloadStatus" android:text="@string/select_model_and_download" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                <TextView android:text="@string/downloaded_models" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/tvModelInfo" android:text="" android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/text_primary" android:background="@color/panel" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClearModels" android:text="@string/clear_all_models" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Language -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="@string/language" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@color/surface" android:popupBackground="@color/popup" android:layout_marginTop="6dp" android:padding="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Appearance -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="@string/appearance" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spinnerTheme" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@color/surface" android:popupBackground="@color/popup" android:layout_marginTop="6dp" android:padding="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Voice Typing Accuracy -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="@string/voice_typing" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/speech_is_typed_directly_into_the_focuse" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <TextView android:text="@string/accuracy" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchVad" android:text="@string/vad_auto_stop" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="6dp" android:checked="true"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchLive" android:text="@string/progressive_chunk_typing" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchBt" android:text="@string/bluetooth_mic" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="false"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchCaps" android:text="@string/auto_caps" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchImeChunked" android:text="@string/keyboard_chunked" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchBubbleChunked" android:text="@string/bubble_chunked" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchOutClip" android:text="@string/copy_outstanding_transcripts_to_clipboar" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:checked="true"/>

                <TextView android:id="@+id/tvCores" android:text="@string/cpu_cores_detected" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <Spinner android:id="@+id/spinnerThreads" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@color/surface" android:popupBackground="@color/popup" android:layout_marginTop="4dp"/>

                <TextView android:text="@string/pause_that_ends_a_chunk" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <SeekBar android:id="@+id/seekChunkSilence" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="19"/>
                    <TextView android:id="@+id/tvChunkSilence" android:text="@string/val_4_5s" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
                <TextView android:id="@+id/tvChunkDescription" android:text="" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <SeekBar android:id="@+id/seekChunkLength" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:min="1" android:max="45"/>
                    <TextView android:id="@+id/tvChunkLength" android:text="@string/val_30s" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
                <TextView android:text="@string/keyboard_auto_stop_ends_the_whole_record" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <SeekBar android:id="@+id/seekStopSilence" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:min="5" android:max="60"/>
                    <TextView android:id="@+id/tvStopSilence" android:text="@string/val_10s" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
                <TextView android:text="@string/unload_model_when_idle_battery_saver" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <SeekBar android:id="@+id/seekUnloadIdle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:min="0" android:max="12"/>
                    <TextView android:id="@+id/tvUnloadIdle" android:text="@string/val_60s" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
                <TextView android:text="@string/chunked_on_text_appears_progressively_of" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                <TextView android:text="@string/vad_silence_splits_chunks_meeting_never" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Full audio archive -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface" android:layout_marginTop="12dp" app:strokeColor="#E0E0E0" app:strokeWidth="1dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:text="@string/audio_archive_saved_with_transcript" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/full_session_audio_in_documents_whispern" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchSaveAudioMeeting" android:text="@string/save_meeting_audio_keyboard_always_types" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:checked="true"/>
                <TextView android:text="@string/format" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <Spinner android:id="@+id/spinnerAudioFormat" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@color/surface" android:popupBackground="@color/popup" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating mic bubble -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bubble_bg" app:strokeColor="#B2DFDB" app:strokeWidth="1dp" android:layout_marginTop="12dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:text="@string/mic_bubble_one_tap_switch" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchBubble" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:text="@string/floating_on_screen_tap_whisper_your_keyb" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:text="@string/transparency" android:textSize="12sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="6dp"/>
                    <SeekBar android:id="@+id/seekBubbleAlpha" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="80" android:progress="20"/>
                    <TextView android:id="@+id/tvBubbleAlpha" android:text="75%" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/tvSettingsHint" android:text="@string/changes_save_automatically" android:textSize="12sp" android:textColor="@color/text_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp"/>

    </LinearLayout>
</ScrollView>
